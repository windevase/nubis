<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- SSH.NET 은 저장소 안의 포크 패키지만 쓴다 (tools\build-sshnet.ps1, third_party\SSH.NET) -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="nubis-local" value="third_party/SSH.NET/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nubis-local">
      <package pattern="SSH.NET" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
