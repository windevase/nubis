<Window x:Class="Nubis.VaultEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Width="500" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Background="#1B1E2C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="12"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,22">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="사용자명과 비밀번호, SSH 키 중 필요한 것을 저장하세요. 비밀번호와 키 중 하나는 있어야 합니다."
                       Foreground="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="이름" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Tag="예: 운영 서버 root, 배포 계정"/>

            <TextBlock Text="사용자명" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Tag="예: root  /  ubuntu  /  DOMAIN\user"/>

            <Grid Margin="0,16,0,6">
                <TextBlock x:Name="PasswordLabel" Text="비밀번호 (선택)" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ClearPasswordBox" Content="저장된 비밀번호 지우기" HorizontalAlignment="Right" FontSize="12"
                          Visibility="Collapsed"/>
            </Grid>
            <PasswordBox x:Name="PasswordBox"/>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0"/>
            <Grid Margin="0,14,0,6">
                <TextBlock x:Name="KeyLabel" Text="SSH 개인키 (선택)" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ClearKeyBox" Content="저장된 키 지우기" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                              Visibility="Collapsed"/>
                    <Button Style="{StaticResource GhostButton}" Content="파일에서 가져오기" Padding="10,4" FontSize="12" Click="OnImportKey"/>
                </StackPanel>
            </Grid>
            <TextBox x:Name="KeyBox" Height="110" AcceptsReturn="True" TextWrapping="NoWrap" Padding="10,8"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                     Tag="-----BEGIN OPENSSH PRIVATE KEY----- 또는 PuTTY(.ppk) 내용 붙여넣기"/>
            <TextBlock Text="키 암호 (키에 암호가 걸려 있을 때)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PassphraseBox"/>

            <TextBlock Text="메모 (선택)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NoteBox"/>

            <TextBlock Text="Windows DPAPI 로 암호화해 이 PC·이 Windows 계정에서만 풀 수 있게 저장합니다. Claude 패널은 이 파일을 읽지 못하게 막혀 있습니다."
                       FontSize="11" Foreground="{StaticResource SubText}" Margin="2,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource Danger}" Margin="2,8,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="취소" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="80"/>
                <Button Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
