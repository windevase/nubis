<!--
    Nubis 디자인 토큰 (다크 · Windows 11 Fluent + Linear 계열)
    App.xaml 이 MergedDictionaries 로 읽는다. 컨트롤 스타일은 App.xaml 에 있다.

    층(Layer) 구조 — 아래에서 위로 밝아진다. 같은 층끼리는 Stroke(머리카락 선)로 나눈다.
      Base     : 창 바탕 · 타이틀바 (Mica 가 켜지면 비친다)
      Layer1   : 사이드바 · Claude 패널 등 크롬 영역
      Layer2   : 본문(페이지) 바탕
      Layer3   : 카드 · 패널 · 목록 행 묶음
      Overlay  : 대화상자 · 메뉴 · 툴팁 · 토스트 (그림자 허용)
    알파(반투명 흰색) 채움은 어느 층 위에 놓아도 한 단계 밝아지므로 버튼 · 입력란 · 선택 표시에 쓴다.

    예전 키(TitleBg, SidebarBg, Bg, CardBg, CardHoverBg, InputBg, Line, Text, SubText, Accent, AccentHover,
    RdpBrush, Danger, DialogBg, InputHoverLine, DialogText, Warn 와 *Color)는 이름을 바꾸지 않고 값만 새 팔레트로 옮겼다.
    새 화면 작업에서는 아래 "새 키" 를 우선 쓴다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= 색 (Color) ================= -->
    <!-- 층 -->
    <Color x:Key="BaseColor">#0B0D12</Color>
    <Color x:Key="Layer1Color">#101218</Color>
    <Color x:Key="Layer2Color">#14161C</Color>
    <Color x:Key="Layer3Color">#1B1E26</Color>
    <Color x:Key="Layer3HoverColor">#22252F</Color>
    <Color x:Key="OverlayColor">#1E2129</Color>
    <Color x:Key="OverlayRaisedColor">#252831</Color>
    <!-- 선 (흰색 알파) -->
    <Color x:Key="StrokeSubtleColor">#0FFFFFFF</Color>
    <Color x:Key="StrokeColor">#17FFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#29FFFFFF</Color>
    <Color x:Key="ControlStrokeColor">#5AFFFFFF</Color>
    <!-- 글자 -->
    <Color x:Key="TextPrimaryColor">#EDEFF4</Color>
    <Color x:Key="TextSecondaryColor">#A0A6B4</Color>
    <Color x:Key="TextTertiaryColor">#717789</Color>
    <Color x:Key="TextDisabledColor">#4D525F</Color>
    <!-- 강조색 (브랜드 청록 계열 유지, 채도를 살짝 정리) -->
    <Color x:Key="AccentBaseColor">#2CC9A3</Color>
    <Color x:Key="AccentHoverBaseColor">#46D6B3</Color>
    <Color x:Key="AccentPressedColor">#23AD8B</Color>
    <Color x:Key="AccentTextColor">#5CDDBF</Color>
    <Color x:Key="OnAccentColor">#04241C</Color>
    <Color x:Key="AccentSubtleColor">#1F2CC9A3</Color>
    <Color x:Key="AccentSubtleHoverColor">#332CC9A3</Color>
    <!-- 의미 색 -->
    <Color x:Key="SuccessColor">#46C08A</Color>
    <Color x:Key="WarningColor">#F5B740</Color>
    <Color x:Key="DangerBaseColor">#EC5257</Color>
    <Color x:Key="DangerHoverColor">#F26A6F</Color>
    <Color x:Key="InfoColor">#5B93FF</Color>
    <!-- 중립 알파 채움 (버튼 · 입력란 · 목록 hover/선택) -->
    <Color x:Key="ControlFillColor">#0FFFFFFF</Color>
    <Color x:Key="ControlFillHoverColor">#17FFFFFF</Color>
    <Color x:Key="SubtleFillHoverColor">#0FFFFFFF</Color>
    <Color x:Key="SubtleFillSelectedColor">#17FFFFFF</Color>
    <Color x:Key="InputFillColor">#0AFFFFFF</Color>
    <Color x:Key="InputFillFocusColor">#29000000</Color>
    <Color x:Key="PressedOverlayColor">#26000000</Color>
    <Color x:Key="ScrollThumbColor">#38FFFFFF</Color>
    <Color x:Key="ScrollThumbHoverColor">#66FFFFFF</Color>
    <!-- Mica 위에 깔 색조 (WindowBackdrop 이 Mica 를 켰을 때만 쓰임). 알파를 낮출수록 배경화면 색이 더 비친다 -->
    <Color x:Key="MicaTitleBarTintColor">#8C0B0D12</Color>
    <Color x:Key="MicaSidebarTintColor">#A6101218</Color>

    <!-- 예전 Color 키 (값만 새 팔레트) -->
    <Color x:Key="TitleBgColor">#0B0D12</Color>
    <Color x:Key="SidebarColor">#101218</Color>
    <Color x:Key="BgColor">#14161C</Color>
    <Color x:Key="CardColor">#1B1E26</Color>
    <Color x:Key="CardHoverColor">#22252F</Color>
    <Color x:Key="InputBgColor">#0AFFFFFF</Color>
    <Color x:Key="LineColor">#17FFFFFF</Color>
    <Color x:Key="TextColor">#EDEFF4</Color>
    <Color x:Key="SubTextColor">#A0A6B4</Color>
    <Color x:Key="AccentColor">#2CC9A3</Color>
    <Color x:Key="AccentHoverColor">#46D6B3</Color>
    <Color x:Key="RdpColor">#4F8CFF</Color>
    <Color x:Key="DangerColor">#EC5257</Color>

    <!-- ================= 브러시 — 새 키 ================= -->
    <!-- 층: 창/타이틀바 · 사이드바 · 페이지 · 카드 · 카드 hover · 대화상자 · 메뉴/툴팁/토스트 -->
    <SolidColorBrush x:Key="BaseBg" Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="Layer1Bg" Color="{StaticResource Layer1Color}"/>
    <SolidColorBrush x:Key="Layer2Bg" Color="{StaticResource Layer2Color}"/>
    <SolidColorBrush x:Key="Layer3Bg" Color="{StaticResource Layer3Color}"/>
    <SolidColorBrush x:Key="Layer3HoverBg" Color="{StaticResource Layer3HoverColor}"/>
    <SolidColorBrush x:Key="OverlayBg" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="OverlayRaisedBg" Color="{StaticResource OverlayRaisedColor}"/>
    <!-- 선: 아주 옅은 구분 · 기본 구분선/테두리 · hover·강한 테두리 · 체크박스 등 컨트롤 외곽 -->
    <SolidColorBrush x:Key="StrokeSubtle" Color="{StaticResource StrokeSubtleColor}"/>
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="ControlStroke" Color="{StaticResource ControlStrokeColor}"/>
    <!-- 글자: 본문 · 보조(설명) · 3차(placeholder, 메타 정보) · 비활성 -->
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
    <!-- 강조: 채움 · hover · 눌림 · 어두운 바탕 위 강조 글자/링크 · 강조 채움 위 글자 · 선택 표시(옅은 채움) -->
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="AccentSubtleHover" Color="{StaticResource AccentSubtleHoverColor}"/>
    <!-- 의미 색 + 옅은 채움(배지 · 안내 띠 배경, 약 14%) -->
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSubtle" Color="#2446C08A"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSubtle" Color="#24F5B740"/>
    <!-- 슬라이드 패널 뒤를 어둡게 덮는 막 (편집 패널 등) -->
    <SolidColorBrush x:Key="Scrim" Color="#8C000000"/>
    <SolidColorBrush x:Key="DangerHover" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerSubtle" Color="#24EC5257"/>
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSubtle" Color="#245B93FF"/>
    <!-- 중립 채움: 기본 버튼 · 기본 버튼 hover · 투명 컨트롤 hover · 선택(중립) · 입력란 · 포커스된 입력란 · 눌림 덧칠 -->
    <SolidColorBrush x:Key="ControlFill" Color="{StaticResource ControlFillColor}"/>
    <SolidColorBrush x:Key="ControlFillHover" Color="{StaticResource ControlFillHoverColor}"/>
    <SolidColorBrush x:Key="SubtleFillHover" Color="{StaticResource SubtleFillHoverColor}"/>
    <SolidColorBrush x:Key="SubtleFillSelected" Color="{StaticResource SubtleFillSelectedColor}"/>
    <SolidColorBrush x:Key="InputFill" Color="{StaticResource InputFillColor}"/>
    <SolidColorBrush x:Key="InputFillFocus" Color="{StaticResource InputFillFocusColor}"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="{StaticResource PressedOverlayColor}"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="{StaticResource ScrollThumbHoverColor}"/>
    <!-- Mica 배경 자리 (DynamicResource 로 써야 한다). 기본값 = 단색, Mica 가 켜지면 WindowBackdrop 이 창 리소스로 덮어쓴다.
         TitleBarBackdrop: 타이틀바 · SidebarBackdrop: 홈 사이드바 · ContentBackdrop: 본문 행 바탕(페이지는 각자 Layer2Bg 를 깐다) -->
    <SolidColorBrush x:Key="TitleBarBackdrop" Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBackdrop" Color="{StaticResource Layer1Color}"/>
    <SolidColorBrush x:Key="ContentBackdrop" Color="{StaticResource Layer2Color}"/>
    <SolidColorBrush x:Key="MicaTitleBarTint" Color="{StaticResource MicaTitleBarTintColor}"/>
    <SolidColorBrush x:Key="MicaSidebarTint" Color="{StaticResource MicaSidebarTintColor}"/>

    <!-- ================= 브러시 — 예전 키 (이름 유지, 새 팔레트 값) ================= -->
    <SolidColorBrush x:Key="TitleBg" Color="{StaticResource TitleBgColor}"/>
    <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBg" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBg" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="InputBg" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubText" Color="{StaticResource SubTextColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="RdpBrush" Color="{StaticResource RdpColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <!-- 대화상자 배경 · 마우스를 올린 입력란 테두리 · 대화상자 본문 글자 (각 창에 색을 직접 쓰지 않게) -->
    <SolidColorBrush x:Key="DialogBg" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="InputHoverLine" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="DialogText" Color="#C6CAD4"/>
    <!-- 경고 · 진행 중 표시 (노랑) — 승인 대기 · 입력 오류 안내 · 실행 중 점 -->
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarningColor}"/>

    <!-- ================= 모서리 반경 ================= -->
    <!-- Sm 4: 배지 · 작은 칩 · 체크박스 / Md 6: 버튼 · 입력란 · 메뉴 항목 · 목록 행 / Lg 8: 카드 · 메뉴 · 툴팁 / Xl 12: 대화상자 · 큰 패널 -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>

    <!-- ================= 간격 (4 배수) =================
         요소 사이: 4(아이콘-글자) · 8(관련 컨트롤) · 12(카드 사이) · 16(묶음 사이) · 24(섹션 사이) · 32(페이지 큰 구획)
         Thickness 키는 Padding/Margin 에 바로 쓴다 -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <Thickness x:Key="PadPage">28,24,28,24</Thickness>
    <Thickness x:Key="PadCard">16,14,16,14</Thickness>
    <Thickness x:Key="PadDialog">24,22,24,20</Thickness>
    <Thickness x:Key="PadControl">12,7,12,7</Thickness>

    <!-- ================= 그림자 (Elevation) =================
         Shadow2: 살짝 뜬 요소(선택된 세그먼트 등) / Shadow8: 메뉴 · 콤보 목록 · hover 로 들린 카드 1장 / Shadow16: 대화상자 · 큰 팝업
         ※ 성능: DropShadowEffect 는 요소를 오프스크린으로 다시 그린다. 가상화 목록의 항목(호스트 카드 · SFTP 행 · 미리보기 행)에는
           절대 상시로 걸지 않는다 — 카드는 Layer3Bg + Stroke 로 구분하고, 그림자가 필요하면 Anim.HoverLift(마우스가 올라간 1장만) 를 쓴다.
           AllowsTransparency=True 창(기존 대화상자들)은 소프트웨어 렌더링이므로 그 위 그림자는 창 하나당 1개(외곽 Border)로 제한한다.
         공유 인스턴스이므로 코드에서 값을 바꾸지 말 것 (필요하면 Clone) -->
    <DropShadowEffect x:Key="Shadow2" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow8" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.30" Color="#000000" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow16" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.38" Color="#000000" RenderingBias="Performance"/>

    <!-- ================= 움직임 =================
         상호작용(hover · 누름 · 열기)에만 짧게 — 계속 도는 애니메이션은 쓰지 않는다. 코드에서는 Anim 클래스(Core\Anim.cs) 사용 -->
    <Duration x:Key="MotionFast">0:0:0.1</Duration>
    <Duration x:Key="MotionNormal">0:0:0.15</Duration>

    <!-- ================= 글꼴 ================= -->
    <!-- 한글은 Segoe UI Variable 에 없어 Malgun Gothic 으로 대체된다 — 목록 끝의 Malgun Gothic 을 지우지 말 것 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ================= 타입 램프 (TextBlock 스타일) =================
         TextCaption 12 보조 · TextBody 13 · TextBodyLarge 14 · TextBodyStrong 13 SemiBold
         TextSubtitle 16 SemiBold(카드 · 대화상자 제목) · TextTitle 20 SemiBold(페이지 제목) · TextTitleLarge 24 SemiBold
         TextOverline 11 SemiBold 보조색 (섹션 머리글 · 그룹 이름)
         ※ 암시적 TextBlock 스타일은 만들지 않는다 (컨트롤 템플릿 안 글자까지 바뀜) -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextBodyLarge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextBodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextTitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="TextOverline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
    </Style>
    <!-- 입력란 위 이름표 (예전 키) -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SubText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
</ResourceDictionary>
