<UserControl x:Class="Nubis.PortForwardList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Nubis"
             Background="{StaticResource Layer2Bg}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <!-- 포트 포워딩 목록 (클러스터 탭 터미널 위). 행 모양은 SSH 포트 포워딩과 함께 쓸 수 있게 IPortForwardRow 만 본다 -->
    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="10,6,6,6">
        <DockPanel>
            <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextTertiary}"
                       Margin="2,0,0,4"/>
            <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="RowList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="{StaticResource RadiusMd}" Padding="6,3,2,3" Margin="0,0,0,2" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource TextTertiary}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Label}"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusText}">
                                            <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopy" ToolTip="{l:Tr '로컬 주소 복사'}"/>
                                        <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="OnOpenBrowser"
                                                ToolTip="{l:Tr '브라우저로 열기'}"/>
                                        <Button x:Name="RestartButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRestart"
                                                ToolTip="{l:Tr '다시 시작'}" Visibility="Collapsed"/>
                                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Click="OnStopOrRemove"
                                                ToolTip="{l:Tr '중지'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SubtleFillHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static l:PortForwardState.Active}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static l:PortForwardState.Starting}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static l:PortForwardState.Failed}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BrowserUrl}" Value="{x:Null}">
                                    <Setter TargetName="OpenButton" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanRestart}" Value="True">
                                    <Setter TargetName="RestartButton" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OpenButton" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="StopButton" Property="Content" Value="&#xE711;"/>
                                    <Setter TargetName="StopButton" Property="ToolTip" Value="{l:Tr '목록에서 지우기'}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
