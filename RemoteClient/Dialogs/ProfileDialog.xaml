<Window x:Class="Nubis.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="{l:Tr '프로필 설정'}" Width="440" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <!-- 대화상자 틀: Overlay 면 + 강한 머리카락 테두리 + 그림자 1개(투명 창이라 외곽 Border 에만) -->
    <Border Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}" Margin="16" Effect="{StaticResource Shadow16}"
            MouseLeftButtonDown="OnDrag">
        <StackPanel Margin="{StaticResource PadDialog}">
            <!-- 머리글: 공급자 배지 + 그룹 이름, 아래에 프로필(구독·프로젝트) 이름 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" CornerRadius="{StaticResource RadiusSm}" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BaseBg}"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource TextSubtitle}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock x:Name="SubText" Style="{StaticResource TextCaption}" Margin="0,6,0,4" TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="{l:Tr '그룹 이름'}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="{l:Tr '기본 사용자명'}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Tag="{l:Tr '이 그룹 서버 접속 시 사용할 계정'}"/>
            <TextBlock Text="{l:Tr '기본 비밀번호'}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PassBox"/>
            <TextBlock Text="{l:Tr '호스트별로 따로 지정한 계정이 있으면 그 값이 우선합니다. 비우면 접속할 때 묻습니다.'}"
                       FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="2,6,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr 'SSH 포트 (Linux)'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SshPortBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr 'RDP 포트 (Windows)'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RdpPortBox"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warning}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock Text="{l:Tr '기본 접속 주소 (공인 IP 가 있는 서버)'}" Style="{StaticResource FieldLabel}"/>
            <Border Background="{StaticResource InputFill}" CornerRadius="{StaticResource RadiusLg}" Padding="3" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="PrivateIp" Style="{StaticResource Segment}" Content="{l:Tr '사설 IP'}" GroupName="addr"/>
                    <RadioButton x:Name="PublicIp" Style="{StaticResource Segment}" Content="{l:Tr '공인 IP (없으면 사설)'}" GroupName="addr"/>
                </UniformGrid>
            </Border>

            <CheckBox x:Name="StoppedBox" Content="{l:Tr '중지된 서버도 목록에 포함'}" Margin="0,16,0,0"/>
            <CheckBox x:Name="UnhideBox" Margin="0,10,0,0" Visibility="Collapsed"/>

            <!-- 바닥: 오른쪽 정렬 (보조 → 주 동작) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{l:Tr '취소'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="80"/>
                <Button Content="{l:Tr '저장'}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
