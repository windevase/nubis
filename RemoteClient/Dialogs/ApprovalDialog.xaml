<Window x:Class="Nubis.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="{l:Tr 'Claude 실행 승인'}" Width="620" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Background="#1B1E2C" BorderBrush="#F5B740" BorderThickness="1" CornerRadius="12" Margin="12"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,22">
            <StackPanel Orientation="Horizontal">
                <Border Background="#F5B740" CornerRadius="6" Width="26" Height="26">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#1B1E2C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DescText" Foreground="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock x:Name="TargetsLabel" Style="{StaticResource FieldLabel}"/>
            <Border Background="{StaticResource InputBg}" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TargetsText" Margin="12,10" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{l:Tr '명령'}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CommandBox" IsReadOnly="True" Height="Auto" MinHeight="44" MaxHeight="220" Padding="12,10"
                     FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" AcceptsReturn="True"/>

            <TextBlock x:Name="WarnText" Foreground="#F0616D" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{l:Tr '거부'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="90"/>
                <Button x:Name="OkButton" Content="{l:Tr '실행'}" Style="{StaticResource PrimaryButton}" Click="OnOk" MinWidth="90"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
