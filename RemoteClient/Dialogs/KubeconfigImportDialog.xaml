<Window x:Class="Nubis.KubeconfigImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="{l:Tr 'kubeconfig 가져오기'}" Width="640" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <Border Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}" Margin="20,14,20,26" Effect="{StaticResource Shadow16}"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="{StaticResource PadDialog}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSubtle}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr 'kubeconfig 가져오기'}" Style="{StaticResource TextSubtitle}"/>
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr '고른 context 마다 그 클러스터 인증만 담아 따로 저장합니다 (Windows DPAPI 암호화). 원본 파일은 바꾸지 않습니다.'}"/>
                    </StackPanel>
                </Grid>

                <!-- 가져올 곳 -->
                <Border Background="{StaticResource InputBg}" CornerRadius="{StaticResource RadiusLg}" Padding="3"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="SrcDefault" Style="{StaticResource Segment}" Content="~/.kube/config" GroupName="src" IsChecked="True" Checked="OnSourceChanged"/>
                        <RadioButton x:Name="SrcFile" Style="{StaticResource Segment}" Content="{l:Tr '파일...'}" GroupName="src" Checked="OnSourceChanged"/>
                        <RadioButton x:Name="SrcPaste" Style="{StaticResource Segment}" Content="{l:Tr '붙여넣기'}" GroupName="src" Checked="OnSourceChanged"/>
                    </UniformGrid>
                </Border>
                <TextBlock x:Name="SourceText" Style="{StaticResource TextCaption}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="PasteBox" Height="120" AcceptsReturn="True" TextWrapping="NoWrap" Padding="10,8" Margin="0,8,0,0"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" Visibility="Collapsed" TextChanged="OnPasteChanged"
                         Tag="{l:Tr 'kubeconfig YAML 붙여넣기'}" AutomationProperties.Name="{l:Tr 'kubeconfig YAML 붙여넣기'}"/>

                <!-- context 목록 -->
                <TextBlock Text="{l:Tr '가져올 클러스터 (context)'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <Border Background="{StaticResource Layer3Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" MaxHeight="260" MinHeight="60">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ContextList" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanImport}" Margin="8,6" Foreground="{StaticResource TextPrimary}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <Border Background="{StaticResource ControlFill}" CornerRadius="{StaticResource RadiusSm}" Padding="6,0" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Warning}" Margin="8,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextTertiary}" Margin="16" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 그룹 -->
                <TextBlock Text="{l:Tr '그룹 (선택)'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox x:Name="GroupBox" Tag="{l:Tr '예: Production, Staging'}" AutomationProperties.Name="{l:Tr '그룹 (선택)'}"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerHover}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Layer2Bg}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11" Padding="24,14,24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr '취소'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="96"/>
                    <Button x:Name="OkButton" Content="{l:Tr '가져오기'}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="96"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
