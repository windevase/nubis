<!--
    명령 팔레트 (Ctrl+K) — 호스트 · 열린 탭 · 앱 동작을 한 검색창에서.
    터미널(WebView2) · RDP(ActiveX) 는 HWND 라 메인 창 안의 WPF 오버레이가 그 아래로 숨으므로 소유된 별도 창으로 띄운다.
    AllowsTransparency 를 쓰지 않는다 (레이어드 창 = 소프트웨어 렌더링) — 모서리 · 테두리는 Windows 11 DWM 이 그린다 (코드 숨김).
    그래서 WPF 그림자(Shadow16)는 창 밖으로 그려지지 않아 쓰지 않는다. 목록 행에도 그림자 없음.
-->
<Window x:Class="Nubis.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="{l:Tr '명령 팔레트'}" Width="640" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True"
        Background="{StaticResource OverlayBg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 검색 입력: 테두리 · 채움 없는 큰 입력란 (Tag = placeholder) -->
        <Style x:Key="PaletteInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiary}" Padding="2,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 결과 행: 포커스를 받지 않는다 (키보드는 늘 검색창에 — ↑↓ 는 창이 처리) -->
        <Style x:Key="PaletteRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <DataTemplate x:Key="PaletteRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="sub" Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Protocol}" Value="Ssh">
                    <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Protocol}" Value="Rdp">
                    <Setter TargetName="ic" Property="Foreground" Value="{StaticResource RdpBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle}" Value="">
                    <Setter TargetName="sub" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 검색 -->
            <Grid Margin="16,0,16,0" Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="QueryBox" Grid.Column="1" Style="{StaticResource PaletteInput}"
                         Tag="{l:Tr '호스트 · 탭 · 동작 검색'}" TextChanged="OnQueryChanged"/>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{StaticResource Stroke}"/>

            <!-- 결과 (가상화 · 재활용) -->
            <ListBox x:Name="Results" Grid.Row="2" MaxHeight="420" Margin="6" Background="Transparent" BorderThickness="0"
                     Focusable="False" IsTabStop="False" SelectionMode="Single"
                     ItemContainerStyle="{StaticResource PaletteRow}" ItemTemplate="{StaticResource PaletteRowTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     PreviewMouseLeftButtonUp="OnResultsMouseUp">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="{l:Tr '검색 결과가 없습니다'}" Style="{StaticResource TextCaption}"
                       Margin="22,16,22,16" Visibility="Collapsed"/>

            <!-- 바닥 안내 -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"
                           Text="{l:Tr '↑↓ 이동 · Enter 실행 · Shift+Enter 공인 IP 로 연결 · Ctrl+Enter 편집 · Esc 닫기'}"/>
            </Border>
        </Grid>
    </Border>
</Window>
