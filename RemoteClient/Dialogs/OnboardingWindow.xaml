<Window x:Class="Nubis.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="Nubis" Width="760" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Background="#1B1E2C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="12"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="28,24,28,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/nubis-256.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr 'Nubis 시작하기'}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:Tr '필요한 것부터 골라 설정하세요. 직접 해도 되고, 오른쪽 Claude 패널에 물어보며 해도 됩니다.'}"
                               FontSize="12.5" Foreground="{StaticResource SubText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- 카드는 코드에서 만든다 (OnboardingWindow.xaml.cs) -->
            <UniformGrid x:Name="Cards" Columns="2" Margin="0,20,0,0"/>

            <Border x:Name="ClaudeStatus" Background="{StaticResource InputBg}" CornerRadius="8" Padding="14,10" Margin="0,6,0,0">
                <TextBlock x:Name="ClaudeStatusText" FontSize="12" Foreground="{StaticResource SubText}" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,18,0,0">
                <TextBlock Text="{l:Tr '이 안내는 Settings 에서 다시 열 수 있습니다.'}" FontSize="11.5" Foreground="{StaticResource SubText}"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '닫기'}" HorizontalAlignment="Right" MinWidth="90"
                        IsCancel="True" IsDefault="True" Click="OnClose"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
