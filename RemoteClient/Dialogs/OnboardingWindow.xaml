<Window x:Class="Nubis.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="Nubis" Width="776" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <!-- 공통 대화상자 틀 (MessageDialog 와 같음) — 머리글(로고 · 제목) · 카드 2열 · Claude 상태 띠 · 버튼 띠 -->
    <Border Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}" Margin="20,14,20,26" Effect="{StaticResource Shadow16}"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="28,26,28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/nubis-256.png" Width="44" Height="44" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr 'Nubis 시작하기'}" Style="{StaticResource TextTitle}"/>
                        <TextBlock Text="{l:Tr '필요한 것부터 골라 설정하세요. 직접 해도 되고, 오른쪽 Claude 패널에 물어보며 해도 됩니다.'}"
                                   Style="{StaticResource TextBody}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- 카드는 코드에서 만든다 (OnboardingWindow.xaml.cs) -->
                <UniformGrid x:Name="Cards" Columns="2" Margin="0,22,0,0"/>

                <!-- Claude Code CLI 설치 상태 (아이콘 · 색은 코드에서: 설치됨 = 초록 확인, 없음 = 노랑 경고) -->
                <Border x:Name="ClaudeStatus" Background="{StaticResource Layer3Bg}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="14,10" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClaudeStatusIcon" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock x:Name="ClaudeStatusText" Grid.Column="1" FontSize="12" Foreground="{StaticResource DialogText}" LineHeight="18" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Layer2Bg}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11" Padding="28,14,24,14">
                <Grid>
                    <TextBlock Text="{l:Tr '이 안내는 Settings 에서 다시 열 수 있습니다.'}" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '닫기'}" HorizontalAlignment="Right" MinWidth="96"
                            IsCancel="True" IsDefault="True" Click="OnClose"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
