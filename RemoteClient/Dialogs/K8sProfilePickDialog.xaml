<Window x:Class="Nubis.K8sProfilePickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        Title="{l:Tr '클러스터를 찾을 클라우드 프로필'}" Width="560" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <Border Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}" Margin="20,14,20,26" Effect="{StaticResource Shadow16}"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="{StaticResource PadDialog}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSubtle}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr '클러스터를 찾을 클라우드 프로필'}" Style="{StaticResource TextSubtitle}"/>
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr '고른 프로필만 조회하고 앞으로 동기화할 때 함께 갱신합니다. 클러스터가 있는 모든 리전을 자동으로 확인합니다.'}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                    <Button Grid.Column="1" Content="{l:Tr '전체 선택'}" Style="{StaticResource LinkButton}" Click="OnSelectAll" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="{l:Tr '전체 해제'}" Style="{StaticResource LinkButton}" Click="OnSelectNone"/>
                </Grid>
                <Border Background="{StaticResource Layer3Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" MaxHeight="320" MinHeight="60">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProfileList" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="8,6" Foreground="{StaticResource TextPrimary}"
                                              AutomationProperties.Name="{Binding Label}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource ControlFill}" CornerRadius="{StaticResource RadiusSm}" Padding="6,0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <CheckBox x:Name="RemoveBox" Margin="2,14,0,0" Foreground="{StaticResource TextPrimary}">
                    <TextBlock Text="{l:Tr '선택 해제한 프로필의 클러스터를 목록에서 제거'}" TextWrapping="Wrap"/>
                </CheckBox>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerHover}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Layer2Bg}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11" Padding="24,14,24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr '취소'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="96"/>
                    <Button x:Name="OkButton" Content="{l:Tr '찾기'}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="96"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
