<Window x:Class="Nubis.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인증" Width="400" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}">
    <Border Background="#1B1E2C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="12"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,22">
            <TextBlock Text="인증 정보 입력" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="TargetText" Foreground="{StaticResource SubText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="사용자명" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Tag="username 또는 DOMAIN\username"/>
            <TextBlock Text="비밀번호" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PassBox"/>
            <CheckBox x:Name="SaveBox" Content="이 호스트에 저장 (로그인 성공 시, Windows DPAPI 암호화)" Margin="0,14,0,0" IsChecked="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="취소" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" MinWidth="80"/>
                <Button Content="연결" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
