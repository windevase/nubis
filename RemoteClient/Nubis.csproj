<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF + WinForms 를 같이 쓰면 implicit using 이 이름 충돌(Button, MessageBox 등)을 일으킨다 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Nubis</RootNamespace>
    <AssemblyName>Nubis</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nubis.ico</ApplicationIcon>
    <Product>Nubis</Product>
    <Description>Nubis - Cloud &amp; AI Remote Client</Description>
    <Version>0.2.5</Version>
    <Authors>windevase</Authors>
    <Company>Nubis</Company>
    <Copyright>Copyright (c) 2026 windevase. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 폴더형 배포: .NET·패키지의 다국어 리소스 폴더(cs, de, ja ...)는 앱이 지원하는 언어만 남긴다 -->
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <!-- PE 헤더에 실제 빌드 시각을 넣는다. 재현 가능 빌드(기본값)는 이 칸에 해시를 넣어
         샌드박스가 "컴파일 시각 조작(timestomp)" 으로 표시한다 -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Nubis.Tests" />
    <!-- 화면 문구 영어 사전 (Core\Localization.cs). 리소스 이름: Lang.en.<파일>.json -->
    <EmbeddedResource Include="Lang\en\*.json" LogicalName="Lang.en.%(Filename).json" />
    <Resource Include="Assets\nubis.ico" />
    <Resource Include="Assets\nubis-256.png" />
    <None Remove="Assets\nubis-512.png" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.EC2" Version="4.0.132.2" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.26" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.25" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SSH.NET" Version="2026.0.0.1-nubis" />
  </ItemGroup>

</Project>

