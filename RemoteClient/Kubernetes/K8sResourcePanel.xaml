<UserControl x:Class="Nubis.K8sResourcePanel"
             xmlns:l="clr-namespace:Nubis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Layer2Bg}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="RowFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="6,0,6,1" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 툴바: 클러스터 이름 | 새로고침 · 자동 새로고침 · 닫기 -->
        <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClusterTitle" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRefresh"
                            ToolTip="{l:Tr '새로고침 (F5)'}" AutomationProperties.Name="{l:Tr '새로고침 (F5)'}"/>
                    <Button x:Name="AutoButton" Style="{StaticResource IconButton}" Content="&#xE916;" Click="OnToggleAuto"
                            AutomationProperties.Name="{l:Tr '자동 새로고침'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Click="OnClose"
                            ToolTip="{l:Tr '닫기'}" AutomationProperties.Name="{l:Tr '닫기'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 종류: 파드 · 디플로이먼트 · 서비스 · 노드 -->
        <Border Grid.Row="1" Margin="8,8,8,0" Background="{StaticResource InputBg}" CornerRadius="{StaticResource RadiusLg}" Padding="3"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <UniformGrid Columns="4">
                <RadioButton x:Name="KindPods" Style="{StaticResource Segment}" Content="Pods" GroupName="k8skind" IsChecked="True" Checked="OnKindChanged"/>
                <RadioButton x:Name="KindDeployments" Style="{StaticResource Segment}" Content="Deploy" GroupName="k8skind" Checked="OnKindChanged"
                             ToolTip="Deployments"/>
                <RadioButton x:Name="KindServices" Style="{StaticResource Segment}" Content="Svc" GroupName="k8skind" Checked="OnKindChanged"
                             ToolTip="Services"/>
                <RadioButton x:Name="KindNodes" Style="{StaticResource Segment}" Content="Nodes" GroupName="k8skind" Checked="OnKindChanged"/>
            </UniformGrid>
        </Border>

        <!-- 네임스페이스 · 검색 -->
        <Grid Grid.Row="2" Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="NamespaceBox" Height="30" SelectionChanged="OnNamespaceChanged"
                      ToolTip="{l:Tr '네임스페이스'}" AutomationProperties.Name="{l:Tr '네임스페이스'}"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" Height="30" Tag="{l:Tr '이름으로 찾기'}" TextChanged="OnSearchChanged"
                     AutomationProperties.Name="{l:Tr '이름으로 찾기'}"/>
        </Grid>

        <!-- 열 머리글 (종류마다 이름이 바뀐다) -->
        <Border Grid.Row="3" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1" Padding="14,0,18,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="H0" Style="{StaticResource HeaderText}" Text="{l:Tr '이름'}"/>
                <TextBlock x:Name="H1" Grid.Column="1" Style="{StaticResource HeaderText}"/>
                <TextBlock x:Name="H2" Grid.Column="2" Style="{StaticResource HeaderText}"/>
                <TextBlock x:Name="H3" Grid.Column="3" Style="{StaticResource HeaderText}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="H4" Grid.Column="4" Style="{StaticResource HeaderText}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                     Padding="0,4,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKeyDown" ContextMenuOpening="OnContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="ItemMenu"/>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusRing}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Height="28" Padding="8,0" Margin="6,0,6,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleFillHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding ToolTipText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ready}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Restarts}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Age}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="16" Visibility="Collapsed"/>
        </Grid>

        <!-- 상태 줄: 개수 · 마지막 갱신 · 오류 -->
        <Border Grid.Row="5" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextTertiary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
    </Border>
</UserControl>
