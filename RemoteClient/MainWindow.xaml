<Window x:Class="Nubis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nubis"
        xmlns:local="clr-namespace:Nubis"
        Title="Nubis" Icon="Assets/nubis.ico" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TitleBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- 세션 탭 우클릭 메뉴 (항목은 열 때 만듦) -->
        <ContextMenu x:Key="TabMenu" Opened="OnTabMenuOpened"/>
        <!-- 세션 탭 -->
        <DataTemplate x:Key="TabTemplate">
            <Border x:Name="bd" Height="30" Margin="4,5,0,5" CornerRadius="8" Padding="12,0,4,0"
                    Background="Transparent" Cursor="Hand" MinWidth="120" MaxWidth="230"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding Title}"
                    ContextMenu="{StaticResource TabMenu}" AllowDrop="True"
                    MouseLeftButtonUp="OnTabClick" MouseDown="OnTabMouseDown"
                    PreviewMouseLeftButtonDown="OnTabDragStart" MouseMove="OnTabDragMove" DragOver="OnTabDragOver" Drop="OnTabDrop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource SubText}"/>
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom" Margin="0,0,-3,-2" Stroke="{StaticResource TitleBg}" StrokeThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" Margin="10,0,6,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubText}"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="8"
                            Content="&#xE8BB;" Click="OnTabClose" ToolTip="{l:Tr '닫기'}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#151826"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#1E2232"/>
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 카드 우클릭 메뉴 (모든 카드가 하나를 공유) -->
        <ContextMenu x:Key="HostCardMenu" Opened="OnHostMenuOpened">
            <MenuItem Header="{l:Tr '연결'}" Click="OnMenuConnect"/>
            <MenuItem Header="{l:Tr '공인 IP로 연결'}" Tag="public" Click="OnMenuConnectPublic"/>
            <MenuItem Header="{l:Tr '사설 IP로 연결'}" Tag="private" Click="OnMenuConnectPrivate"/>
            <MenuItem Header="{l:Tr '즐겨찾기에 추가'}" Tag="fav" Click="OnMenuFavorite"/>
            <MenuItem Header="{l:Tr '편집'}" Click="OnMenuEdit"/>
            <MenuItem Header="{l:Tr '복제'}" Click="OnMenuDuplicate"/>
            <MenuItem Header="{l:Tr '삭제'}" Click="OnMenuDelete"/>
        </ContextMenu>

        <!-- 그룹 헤더 우클릭 메뉴 (항목은 열 때 그룹에 맞게 만듦) -->
        <ContextMenu x:Key="GroupMenu" Opened="OnGroupMenuOpened"/>


        <!-- 호스트 카드 -->
        <DataTemplate x:Key="HostCardTemplate">
            <Border x:Name="card" Width="290" Height="74" Margin="0,0,12,12" CornerRadius="10"
                    BorderThickness="1.5" BorderBrush="Transparent"
                    Background="{StaticResource CardBg}" Cursor="Hand" MouseLeftButtonDown="OnCardMouseDown"
                    ToolTip="{Binding ToolTipText, Mode=OneTime}" Opacity="{Binding CardOpacity, Mode=OneTime}"
                    ContextMenu="{StaticResource HostCardMenu}" ContextMenuOpening="OnCardContextMenuOpening">

                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{Binding IconBrush, Mode=OneTime}">
                        <TextBlock Text="{Binding IconGlyph, Mode=OneTime}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="#0B0D14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="#F5B740" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding FavoriteVisibility, Mode=OneTime}"/>
                            <TextBlock Text="{Binding DisplayName, Mode=OneTime}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle, Mode=OneTime}" FontSize="12" Foreground="{StaticResource SubText}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="editBtn" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;"
                            Visibility="Hidden" Click="OnEditHost" ToolTip="{l:Tr '편집'}"/>
                    <!-- 여러 개 선택했을 때 표시 -->
                    <Border x:Name="checkMark" Grid.Column="2" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}"
                            VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#0B0D14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHoverBg}"/>
                    <Setter TargetName="editBtn" Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- 검색창에서 ↑↓ 로 고른 카드 (Enter 로 연결) -->
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHoverBg}"/>
                </DataTrigger>
                <!-- Ctrl/Shift+클릭으로 고른 카드 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHoverBg}"/>
                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="editBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== 타이틀바 / 탭바 ===================== -->
        <Grid Background="{StaticResource TitleBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="HomeTab" Height="30" Margin="8,5,0,5" CornerRadius="8" Padding="12,0,14,0" Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="OnHomeTab">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Hosts" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 탭이 넘치면 휠로 가로 스크롤, 오른쪽 목록 버튼으로 모든 탭 보기 -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          x:Name="TabsScroll" PreviewMouseWheel="OnTabsWheel" ScrollChanged="OnTabsScrollChanged">
                <ItemsControl x:Name="TabsList" ItemTemplate="{StaticResource TabTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="TabListButton" Style="{StaticResource IconButton}" Content="&#xE70D;" Width="30" Height="30" Margin="4,0,2,0"
                        FontSize="10" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnTabListClick"
                        ToolTip="{l:Tr '모든 탭 보기'}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Width="30" Height="30" Margin="0,0,6,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnNewLocalTerminal" ToolTip="{l:Tr '로컬 PowerShell (Ctrl+Shift+T)'}"/>
                <Button Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="0,0,10,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleClaude" ToolTip="{l:Tr 'Claude Code 패널 (Ctrl+Shift+A)'}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{x:Static local:BrandIcons.ClaudeMark}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Claude" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Tag="#E5484D" Click="OnCloseWindow"/>
            </StackPanel>
        </Grid>

        <!-- ===================== 본문 ===================== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ClaudeColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Claude Code 패널 (오른쪽) -->
            <GridSplitter x:Name="ClaudeSplitter" Grid.Column="1" Width="4" Background="{StaticResource Line}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Visibility="Collapsed" Cursor="SizeWE"/>
            <Grid x:Name="ClaudePanel" Grid.Column="2" Visibility="Collapsed" Background="{StaticResource SidebarBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{x:Static local:BrandIcons.ClaudeMark}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Claude Code" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Tr '· Nubis 연결'}" Foreground="{StaticResource SubText}" FontSize="11.5"
                                       Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" Click="OnOpenAuditLog" ToolTip="{l:Tr 'Claude 실행 기록'}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRestartClaude" ToolTip="{l:Tr 'Claude 다시 시작'}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Click="OnCloseClaude" ToolTip="{l:Tr '닫기 (Ctrl+Shift+A)'}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ContentControl x:Name="ClaudeHost" Grid.Row="1"/>
                <!-- Claude 의 run_command 실행 중 표시 + 취소 -->
                <Border x:Name="RunBar" Grid.Row="1" VerticalAlignment="Top" Background="#2A2410" BorderBrush="#5A4A1A"
                        BorderThickness="0,0,0,1" Padding="12,6,8,6" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Tr '취소'}" Padding="10,3"
                                FontSize="12" Click="OnCancelRuns"/>
                        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="40" Height="3" Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunBarText" Foreground="#F5B740" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 홈(호스트 목록) -->
            <Grid x:Name="HomeView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="20,18,20,20">
                                <Image Source="Assets/nubis-256.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Nubis" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Cloud &amp; AI Remote" FontSize="10.5" Foreground="{StaticResource SubText}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <RadioButton x:Name="NavHosts" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Hosts"
                                         GroupName="nav" IsChecked="True" Checked="OnNavChanged"/>
                            <RadioButton x:Name="NavCloud" Style="{StaticResource NavItem}" Tag="&#xE753;" Content="Cloud"
                                         GroupName="nav" Checked="OnNavChanged"/>
                            <RadioButton x:Name="NavVault" Style="{StaticResource NavItem}" Tag="&#xE8D7;" Content="Vault"
                                         GroupName="nav" Checked="OnNavChanged"/>
                            <RadioButton x:Name="NavKnown" Style="{StaticResource NavItem}" Tag="&#xE72E;" Content="Known Hosts"
                                         GroupName="nav" Checked="OnNavChanged"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                         GroupName="nav" Checked="OnNavChanged"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="FooterText" FontSize="11" Foreground="{StaticResource SubText}"
                                   Margin="20,0,20,16" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- 호스트 페이지 -->
                <Grid x:Name="HostsPage" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="28,22,28,0">
                        <TextBox x:Name="SearchBox" Height="46" FontSize="14" Padding="40,0,110,0"
                                 Tag="{l:Tr '호스트 검색, 또는 user@host[:port] 입력 후 Enter  (RDP 는 rdp host)'}"
                                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubText}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/>
                        <Button Content="CONNECT" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Margin="0,0,6,0" Height="34" Padding="16,0" FontSize="12" Click="OnQuickConnect"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="28,18,28,8">
                        <Grid x:Name="HostToolbar">
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnNewHost" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="NEW HOST" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubText}"
                                       ToolTip="{l:Tr 'Ctrl+클릭 · Shift+클릭으로 카드를 여러 개 골라 한 번에 편집할 수 있습니다 (Ctrl+A 전체 선택)'}"/>
                        </Grid>
                        <!-- 카드를 여러 개 골랐을 때: 일괄 작업 막대 -->
                        <Border x:Name="SelectionBar" Visibility="Collapsed" Background="{StaticResource CardBg}" CornerRadius="8"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="12,4" Margin="0,-3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SelectionText" DockPanel.Dock="Left" Margin="8,0,16,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="OnSelectionClear"
                                            ToolTip="{l:Tr '선택 해제 (Esc)'}"/>
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '일괄 편집...'}" Padding="14,6" FontSize="12" Margin="0,0,6,0"
                                            Click="OnSelectionEdit"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '연결'}" Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                            Click="OnSelectionConnect"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '삭제'}" Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                            Click="OnSelectionDelete"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '더 보기 ▾'}" Padding="12,6" FontSize="12"
                                            Click="OnSelectionMore"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 호스트 목록: 그룹 헤더와 "카드 한 줄"을 행으로 만든 가상화 목록 (수백 대여도 보이는 줄만 그림) -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="HostRows" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Text}"
                                 FocusVisualStyle="{x:Null}" SizeChanged="OnHostRowsSizeChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Padding="28,6,16,28" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.Resources>
                                <!-- 그룹 헤더 행: 클릭하면 접기/펼치기 -->
                                <DataTemplate DataType="{x:Type local:HostGroup}">
                                    <StackPanel Margin="0,4,0,0">
                                            <Border x:Name="header" Background="Transparent" Cursor="Hand" CornerRadius="8"
                                                    Padding="6,6,8,6" Margin="-6,0,12,10" MouseLeftButtonUp="OnGroupHeaderClick"
                                                    ContextMenu="{StaticResource GroupMenu}" ToolTip="{l:Tr '클릭: 접기·펼치기 · 우클릭: 그룹 전체에 Vault 계정·공인/사설 IP 적용, 모두 연결'}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{StaticResource SubText}" VerticalAlignment="Center" Width="16"/>
                                                    <Border x:Name="badge" Grid.Column="1" Background="{Binding BadgeBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#0B0D14"/>
                                                    </Border>
                                                    <TextBlock x:Name="glyph" Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="#F5B740" Margin="4,0,0,0" VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12"
                                                               Foreground="{StaticResource SubText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Profile.StatusText}" FontSize="12" Margin="14,0,8,0"
                                                               Foreground="{StaticResource SubText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="syncBtn" Grid.Column="5" Style="{StaticResource GhostButton}" Padding="10,4"
                                                            FontSize="12" Click="OnGroupSync" Visibility="Collapsed" ToolTip="{l:Tr '이 프로필의 서버 목록을 다시 가져옵니다'}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                            <TextBlock Text="{Binding Profile.SyncButtonText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="header" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="header" Property="Background" Value="#1A1D2B"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCloud}" Value="True">
                                            <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="syncBtn" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                            <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                                <!-- 카드 한 줄 -->
                                <DataTemplate DataType="{x:Type local:CardRow}">
                                    <ItemsControl ItemsSource="{Binding Hosts}" ItemTemplate="{StaticResource HostCardTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="44"
                                       Foreground="{StaticResource Line}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyTitle" Text="{l:Tr '등록된 호스트가 없습니다'}" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyHint" Text="{l:Tr 'NEW HOST 로 SSH / RDP 서버를 추가하거나, 위 검색창에 user@host 를 입력해 바로 접속하세요.'}"
                                       Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Vault 페이지 -->
                <Grid x:Name="VaultPage" Grid.Column="1" Visibility="Collapsed" Margin="28,24,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,160,0">
                            <TextBlock Text="Vault" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:Tr '여러 호스트가 함께 쓰는 로그인 계정(사용자명 + 비밀번호 / SSH 키)입니다. 호스트 편집의 \'로그인 계정\' 에서 고르면, 여기서 값을 바꿀 때 그 호스트들에 모두 적용됩니다. \'기본 계정\' 으로 지정하면 계정을 정하지 않은 모든 호스트가 쓰고, 호스트 목록의 그룹 우클릭으로 그룹 전체에 한 번에 지정할 수 있습니다. Windows DPAPI 로 암호화되어 이 PC·이 Windows 계정에서만 풀립니다.'}"
                                       Foreground="{StaticResource SubText}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '계정 추가'}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="OnVaultAdd"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="VaultEmpty" Text="{l:Tr '아직 저장된 계정이 없습니다.'}" Foreground="{StaticResource SubText}" Margin="0,8,0,0"/>
                            <ItemsControl x:Name="VaultList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        <Border Background="{StaticResource InputBg}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MethodsText}" FontSize="10.5" Foreground="{StaticResource SubText}"/>
                                                        </Border>
                                                        <Border Background="#2A2410" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding DefaultBadgeVisibility}">
                                                            <TextBlock Text="{Binding DefaultBadge}" FontSize="10.5" Foreground="#F5B740"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding UsedByText}" FontSize="11" Foreground="{StaticResource SubText}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SubText}" FontSize="12"
                                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '공개키 복사'}" Margin="0,0,8,0"
                                                            Visibility="{Binding CopyVisibility}" Click="OnVaultCopyPublic"
                                                            ToolTip="{l:Tr '서버의 ~/.ssh/authorized_keys 에 붙여넣을 공개키'}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '호스트 보기'}" Margin="0,0,8,0" Click="OnVaultShowHosts"
                                                            ToolTip="{l:Tr '이 계정으로 로그인하는 호스트만 호스트 목록에 표시'}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '기본 계정'}" Margin="0,0,8,0" Click="OnVaultSetDefault"
                                                            ToolTip="{l:Tr '계정을 따로 정하지 않은 모든 호스트가 쓰는 기본 계정으로 지정'}"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '수정'}" Margin="0,0,8,0" Click="OnVaultEdit"/>
                                                    <Button Style="{StaticResource DangerButton}" Content="{l:Tr '삭제'}" Tag="#2A1A22" Click="OnVaultDelete"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Known Hosts 페이지 -->
                <Grid x:Name="KnownPage" Grid.Column="1" Visibility="Collapsed" Margin="28,24,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Known Hosts" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr '신뢰한 SSH 서버 호스트키 지문입니다. 서버를 재설치해 키가 바뀌었다면 여기서 삭제 후 다시 접속하세요.'}"
                                   Foreground="{StaticResource SubText}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="KnownList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource SubText}" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="{l:Tr '삭제'}"
                                                    Tag="#2A1A22" Click="OnKnownDelete" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Cloud 페이지 -->
                <ScrollViewer x:Name="CloudPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="28,24,16,28">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Cloud" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{l:Tr '클라우드 계정의 서버를 프로필 그룹으로 가져옵니다. 인증은 이 PC 에 저장된 인증 프로필(AWS 프로필 · Tencent 자격 증명 · GCP ADC · Azure CLI)을 그대로 사용합니다.'}"/>
                            </StackPanel>
                            <Button x:Name="SyncAllButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OnSyncAll" Content="{l:Tr '전체 동기화'}"/>
                        </Grid>

                        <ItemsControl x:Name="CloudSections" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="18,16" Margin="0,0,12,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Brush}" CornerRadius="6" Padding="9,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#0B0D14"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding AuthHint}" Foreground="{StaticResource SubText}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr '로그인'}" Margin="0,0,8,0" Padding="12,6"
                                                            Click="OnProviderLogin" ToolTip="{l:Tr 'CLI 로그인 명령을 새 창에서 실행합니다'}"/>
                                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Click="OnAddProfiles">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                            <TextBlock Text="{Binding AddButtonText}" Margin="7,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 인증 파일 경로 -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SubText}"
                                                           VerticalAlignment="Center" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PathText}" Foreground="{StaticResource SubText}" FontSize="12"
                                                           FontFamily="Cascadia Mono, Consolas" Margin="8,0,8,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11.5" Click="OnChangeCloudPath"
                                                            Content="{l:Tr '경로 변경'}" ToolTip="{l:Tr '인증 파일(폴더) 위치를 직접 선택'}"/>
                                                    <Button x:Name="resetPathBtn" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11.5" Margin="6,0,0,0"
                                                            Click="OnResetCloudPath" Content="{l:Tr '기본값'}" Visibility="{Binding IsCustomPath, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Message}" Foreground="#F5B740" Margin="0,10,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="2,10,0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="220"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource SubText}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource SubText}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="#F5B740" FontSize="11.5" Margin="0,2,0,0"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,6,0"
                                                                            Content="{Binding SyncButtonText}" Click="OnProfileSync"/>
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnProfileSettings"
                                                                            ToolTip="{l:Tr '기본 계정·포트 설정'}" Margin="0,0,2,0"/>
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnProfileRemove"
                                                                            ToolTip="{l:Tr '프로필과 동기화된 호스트 제거'}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings 페이지 -->
                <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="28,24,16,28">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Text="{l:Tr '언어 · Language'}" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,4"/>
                        <TextBlock Text="{l:Tr '화면 언어를 바꾸면 Nubis 를 다시 시작해야 적용됩니다.'}" Foreground="{StaticResource SubText}" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Width="280" HorizontalAlignment="Left">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="LangKorean" Style="{StaticResource Segment}" Content="한국어" GroupName="lang" Click="OnLanguageClick"/>
                                <RadioButton x:Name="LangEnglish" Style="{StaticResource Segment}" Content="English" GroupName="lang" Click="OnLanguageClick"/>
                            </UniformGrid>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr '시작하기 안내 다시 보기'}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="OnShowOnboarding"/>

                        <TextBlock Text="{l:Tr '기본 Vault 계정'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Foreground="{StaticResource SubText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="{l:Tr '계정을 따로 정하지 않은 모든 호스트가 이 계정으로 로그인합니다. 우선순위: 호스트에 고른 계정·직접 입력한 값 → 클라우드 프로필 기본 계정 → 여기 기본 계정. 호스트 목록에서 그룹을 우클릭하면 그룹 전체에 다른 계정을 지정할 수 있습니다.'}"/>
                        <Grid MaxWidth="640" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Tr 'SSH (Linux)'}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DefSshVaultText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,8">
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '선택'}" Tag="ssh" Click="OnDefaultVaultPick" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '해제'}" Tag="ssh" Click="OnDefaultVaultClear"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{l:Tr 'RDP (Windows)'}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DefRdpVaultText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '선택'}" Tag="rdp" Click="OnDefaultVaultPick" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '해제'}" Tag="rdp" Click="OnDefaultVaultClear"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{l:Tr '호스트 목록 · 탭'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="ShowRecentBox" Click="OnPrefClick" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '최근 접속 그룹 표시'}"/>
                                <Run Text="{l:Tr '  최근 30일 안에 접속한 호스트를 맨 위에 (카드 우클릭 → 즐겨찾기는 항상 맨 위)'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="ConfirmCloseBox" Click="OnPrefClick">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '연결 중인 탭을 닫을 때 확인'}"/>
                                <Run Text="{l:Tr '  X · 휠 클릭 · Ctrl+Shift+W 로 잘못 닫는 것 방지'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{l:Tr '단축키: Ctrl+K 호스트 검색 (↑↓ 로 고르고 Enter 로 연결) · Ctrl+1~9 탭 이동 · Ctrl+Tab 다음 탭 · Ctrl+Shift+W 탭 닫기 · 탭 우클릭: 다시 연결 · 복제 · 이름 바꾸기 · 다른 탭 닫기'}"
                                   Foreground="{StaticResource SubText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{l:Tr '클라우드 자동 동기화'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="{l:Tr '새 서버·바뀐 IP 를 자동으로 반영합니다. 일부 리전 조회가 실패하면 그 회차에는 지우지 않습니다.'}"
                                   Foreground="{StaticResource SubText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <CheckBox x:Name="CloudSyncStartBox" Content="{l:Tr '앱을 시작할 때 전체 동기화'}" Click="OnPrefClick" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Tr '주기적으로 동기화 (분, 0 = 끔, 최소 5)'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="CloudSyncIntervalBox" Width="90" Tag="0" LostFocus="OnCloudSyncIntervalChanged"/>
                        </StackPanel>

                        <TextBlock Text="{l:Tr '터미널 테마'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="{l:Tr '선택하면 열려 있는 SSH 터미널에도 바로 적용됩니다.'}" Foreground="{StaticResource SubText}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="ThemeList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Width="232" Margin="0,0,12,12" CornerRadius="10" BorderThickness="2"
                                            BorderBrush="Transparent" Background="{StaticResource CardBg}" Cursor="Hand"
                                            MouseLeftButtonUp="OnThemeClick">
                                        <StackPanel>
                                            <Border Background="{Binding Theme.BgBrush}" CornerRadius="8,8,0,0" Padding="12,10" Height="104">
                                                <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="11.5">
                                                    <TextBlock>
                                                        <Run Text="user@server" Foreground="{Binding Theme.GreenBrush, Mode=OneWay}"/><Run
                                                             Text=":" Foreground="{Binding Theme.FgBrush, Mode=OneWay}"/><Run
                                                             Text="~" Foreground="{Binding Theme.BlueBrush, Mode=OneWay}"/><Run
                                                             Text="$ ls -l" Foreground="{Binding Theme.FgBrush, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,3,0,0">
                                                        <Run Text="drwxr-x " Foreground="{Binding Theme.FgBrush, Mode=OneWay}"/><Run
                                                             Text="logs " Foreground="{Binding Theme.BlueBrush, Mode=OneWay}"/><Run
                                                             Text="run.sh" Foreground="{Binding Theme.GreenBrush, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,3,0,0">
                                                        <Run Text="ERROR " Foreground="{Binding Theme.RedBrush, Mode=OneWay}"/><Run
                                                             Text="WARN " Foreground="{Binding Theme.YellowBrush, Mode=OneWay}"/><Run
                                                             Text="INFO " Foreground="{Binding Theme.CyanBrush, Mode=OneWay}"/><Run
                                                             Text="DEBUG" Foreground="{Binding Theme.MagentaBrush, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,3,0,0">
                                                        <Run Text="# comment " Foreground="{Binding Theme.CommentBrush, Mode=OneWay}"/><Run
                                                             Text="█" Foreground="{Binding Theme.CursorBrush, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Grid Margin="12,9">
                                                <TextBlock Text="{Binding Theme.Name}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="#3A4060"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox x:Name="AutoContrastBox" Margin="0,8,0,0" Click="OnAutoContrastClick">
                            <TextBlock>
                                <Run Text="{l:Tr '글자색 자동 대비 보정'}"/>
                                <Run Text="{l:Tr '  배경과 비슷해 안 보이는 글자색(밝은 테마의 흰 글자 등)을 읽을 수 있게 자동 조정'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>

                        <TextBlock Text="{l:Tr '터미널 글꼴'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <WrapPanel x:Name="FontPanel"/>
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr '다른 글꼴...'}" HorizontalAlignment="Left" Click="OnOtherFont"
                                ToolTip="{l:Tr '설치된 글꼴 이름을 직접 입력'}"/>

                        <TextBlock Text="{l:Tr '글꼴 크기'}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,4"/>
                        <TextBlock Text="{l:Tr '터미널에서 Ctrl+휠 · Ctrl+= · Ctrl+- 로 그 탭만 잠깐 키우고 줄일 수 있습니다 (Ctrl+0 = 원래 크기).'}"
                                   Foreground="{StaticResource SubText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="&#xE738;" FontFamily="{StaticResource IconFont}"
                                    Width="38" Height="38" Padding="0" FontSize="11" Click="OnFontSmaller"/>
                            <TextBlock x:Name="FontSizeText" Width="56" TextAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                            <Button Style="{StaticResource GhostButton}" Content="&#xE710;" FontFamily="{StaticResource IconFont}"
                                    Width="38" Height="38" Padding="0" FontSize="11" Click="OnFontBigger"/>
                        </StackPanel>

                        <TextBlock Text="{l:Tr '터미널 사용'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="SmartCopyBox" Click="OnPrefClick" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr 'Ctrl+C 로 복사 · Ctrl+V 로 붙여넣기'}"/>
                                <Run Text="{l:Tr '  글자를 선택했을 때만 Ctrl+C 가 복사 (선택이 없으면 실행 중인 명령 중단). Windows Terminal 과 같음'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="PasteConfirmBox" Click="OnPrefClick">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '여러 줄 붙여넣기 전에 확인'}"/>
                                <Run Text="{l:Tr '  줄마다 바로 실행되는 사고 방지 (우클릭 붙여넣기 포함)'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{l:Tr '터미널 단축키: Ctrl+Shift+F 화면 내용 찾기 · Ctrl+Shift+W 탭 닫기 · Ctrl+1~9 탭 이동 · Ctrl+Shift+K 호스트 검색'}"
                                   Foreground="{StaticResource SubText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{l:Tr '구문 강조'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Foreground="{StaticResource SubText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="{l:Tr '출력 내용은 그대로 두고 화면에 색만 덧입힙니다. 서버가 이미 색을 준 글자와 vim·htop 같은 전체 화면 프로그램은 건드리지 않습니다.'}"/>
                        <StackPanel>
                            <CheckBox x:Name="HlIpBox" Click="OnHighlightClick" Margin="0,0,0,10">
                                <TextBlock><Run Text="{l:Tr 'IP 주소'}"/><Run Text="   10.0.1.20  10.0.0.0/16  192.168.0.5:22" Foreground="{StaticResource SubText}"/></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="HlNumBox" Click="OnHighlightClick" Margin="0,0,0,10">
                                <TextBlock><Run Text="{l:Tr '숫자'}"/><Run Text="   1024  512M  99%  30ms" Foreground="{StaticResource SubText}"/></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="HlKwBox" Click="OnHighlightClick">
                                <TextBlock><Run Text="{l:Tr '상태 키워드'}"/><Run Text="{l:Tr '   error·failed·denied (빨강)  warning·timeout (노랑)  ok·success·running (초록)'}" Foreground="{StaticResource SubText}"/></TextBlock>
                            </CheckBox>
                        </StackPanel>

                        <TextBlock Text="{l:Tr '성능'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="GpuBox" Click="OnGpuClick">
                            <TextBlock>
                                <Run Text="{l:Tr '터미널 GPU 가속'}"/>
                                <Run Text="{l:Tr '  대량 출력이 잦을 때만 켜세요. 끄면 메모리 약 70MB 절약 (앱을 다시 시작하면 적용)'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>

                        <TextBlock Text="SSH" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="SshAutoReconnectBox" Click="OnPrefClick" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '연결이 끊기면 자동으로 다시 연결'}"/>
                                <Run Text="{l:Tr '  네트워크 끊김·절전 후 2·4·8·16·32초 간격으로 5번까지 (인증 실패는 다시 시도하지 않음)'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="SshKeyPromptBox" Click="OnSshKeyPromptClick">
                            <TextBlock>
                                <Run Text="{l:Tr '처음 접속하는 서버의 호스트키 확인'}"/>
                                <Run Text="{l:Tr '  끄면 확인 없이 저장 후 접속. 저장된 키와 다르면(중간자 공격 가능) 항상 경고'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>

                        <TextBlock Text="SFTP" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="SftpAutoOpenBox" Click="OnSftpOptionClick" Margin="0,0,0,10">
                            <TextBlock>
                                <Run Text="{l:Tr 'SSH 접속 시 SFTP 패널 자동 열기'}"/>
                                <Run Text="{l:Tr '  로그인에 성공하면 왼쪽에 원격 파일 목록을 붙인다'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="SftpFollowBox" Click="OnSftpOptionClick">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '터미널 폴더 따라가기'}"/>
                                <Run Text="{l:Tr '  터미널에서 cd 하면 SFTP 패널도 그 폴더로 (프롬프트 또는 OSC 7 로 현재 폴더를 읽음). 안 되면 패널의 터미널 버튼으로 이동'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="SftpOpenFolderBox" Click="OnPrefClick" Margin="0,10,0,0" Content="{l:Tr '다운로드가 끝나면 탐색기에서 폴더 열기'}"/>
                        <TextBlock Text="{l:Tr '파일 편집기'}" Margin="0,16,0,4"/>
                        <TextBlock Text="{l:Tr 'SFTP 파일을 더블클릭하면 이 프로그램으로 열고, 저장할 때마다 서버에 자동으로 올린다. 비우면 Windows 기본 프로그램'}"
                                   Foreground="{StaticResource SubText}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SftpEditorBox" Tag="{l:Tr 'Windows 기본 프로그램'}" LostFocus="OnSftpEditorChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="VS Code" Margin="8,0,0,0" Height="38" Click="OnSftpEditorVsCode"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{l:Tr '찾기'}" Margin="8,0,0,0" Height="38" Click="OnSftpEditorBrowse"/>
                        </Grid>

                        <TextBlock Text="{l:Tr '기본 포트'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="{l:Tr '새로 추가하는 호스트와 클라우드 동기화로 만들어지는 서버에 쓰는 포트. 프로필 설정에서 포트를 따로 지정한 프로필은 그 포트를 쓴다'}" Foreground="{StaticResource SubText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SSH" VerticalAlignment="Center" Width="40"/>
                            <TextBox x:Name="DefSshPortBox" Width="90" Tag="22" LostFocus="OnDefaultPortChanged"/>
                            <TextBlock Text="RDP" VerticalAlignment="Center" Width="40" Margin="24,0,0,0"/>
                            <TextBox x:Name="DefRdpPortBox" Width="90" Tag="3389" LostFocus="OnDefaultPortChanged"/>
                        </StackPanel>

                        <TextBlock Text="{l:Tr '시작 화면 로그인'}" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="{l:Tr 'Nubis 를 열 때 GitHub · Google · Microsoft 계정으로 로그인하게 합니다. 허용한 계정만 들어올 수 있습니다. 저장된 서버 목록·계정은 로그인과 별도로 Windows DPAPI 로 암호화되어 있습니다.'}"
                                   Foreground="{StaticResource SubText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="3" BorderBrush="{StaticResource Line}" BorderThickness="1" MaxWidth="560" HorizontalAlignment="Left">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="LoginNone" Style="{StaticResource Segment}" Content="{l:Tr '사용 안 함'}" GroupName="login" Checked="OnLoginProviderChanged" MinWidth="120"/>
                                <RadioButton x:Name="LoginGitHub" Style="{StaticResource Segment}" Content="GitHub" GroupName="login" Checked="OnLoginProviderChanged"/>
                                <RadioButton x:Name="LoginGoogle" Style="{StaticResource Segment}" Content="Google" GroupName="login" Checked="OnLoginProviderChanged"/>
                                <RadioButton x:Name="LoginMicrosoft" Style="{StaticResource Segment}" Content="Microsoft" GroupName="login" Checked="OnLoginProviderChanged"/>
                            </UniformGrid>
                        </Border>
                        <StackPanel x:Name="LoginFields" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock x:Name="LoginHelpText" Foreground="{StaticResource SubText}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LoginClientIdBox"/>
                            <StackPanel x:Name="LoginSecretPanel">
                                <TextBlock Text="{l:Tr 'Client Secret (Google 만 — 비워 두면 저장된 값 유지)'}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="LoginSecretBox"/>
                            </StackPanel>
                            <StackPanel x:Name="LoginTenantPanel">
                                <TextBlock Text="{l:Tr '테넌트 (회사·학교 계정은 organizations, 특정 회사만이면 테넌트 ID 또는 도메인)'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoginTenantBox" Tag="organizations"/>
                            </StackPanel>
                            <TextBlock x:Name="LoginAllowedLabel" Text="{l:Tr '허용 계정'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LoginAllowedBox"/>
                            <StackPanel x:Name="LoginOrgPanel">
                                <TextBlock Text="{l:Tr 'GitHub Organization (이 조직 멤버면 허용 — 선택)'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoginOrgBox" Tag="{l:Tr '예: my-org'}"/>
                            </StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Tr '로그인 유지 (시간, 0 = 실행할 때마다)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LoginRememberBox" Tag="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Tr '오프라인 허용 (일, 0 = 막음)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LoginOfflineBox" Tag="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="LoginSaveButton" Style="{StaticResource PrimaryButton}" Content="{l:Tr '테스트 로그인 후 저장'}" Click="OnLoginSave"/>
                        </StackPanel>
                        <TextBlock x:Name="LoginStatusText" Foreground="{StaticResource SubText}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>

                        <TextBlock Text="Claude" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="AutoReadOnlyBox" Click="OnAutoReadOnlyClick">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{l:Tr '읽기 전용 명령은 승인 없이 실행'}"/>
                                <Run Text="{l:Tr '  조회 명령(ls, df, systemctl status, Get-* 등)만 바로 실행. 그 외 명령·터미널 입력은 승인 창, 감사 로그 기록'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>

                        <TextBlock Text="RDP" FontSize="14" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <CheckBox x:Name="RdpCertBox" Click="OnRdpCertClick">
                            <TextBlock>
                                <Run Text="{l:Tr '서버 인증서 경고 표시'}"/>
                                <Run Text="{l:Tr '  끄면 인증서를 확인할 수 없는 서버(자체 서명)도 경고 없이 바로 접속 — 다음 접속부터 적용'}" Foreground="{StaticResource SubText}"/>
                            </TextBlock>
                        </CheckBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- 호스트 편집 패널 (오른쪽 슬라이드) -->
                <Grid x:Name="EditorLayer" Grid.Column="1" Visibility="Collapsed">
                    <Border Background="#99000000" MouseLeftButtonDown="OnEditorDimClick"/>
                    <Border Width="390" HorizontalAlignment="Right" Background="#1B1E2C"
                            BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="EditorSlide"/>
                        </Border.RenderTransform>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="24,20,16,6">
                                <TextBlock x:Name="EditorTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="OnEditorClose"/>
                            </Grid>

                            <TextBlock x:Name="EditorError" DockPanel.Dock="Bottom" Foreground="#F0616D" FontSize="12" Margin="24,0,24,8"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
                                <Grid>
                                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="{l:Tr '삭제'}"
                                            HorizontalAlignment="Left" Click="OnEditorDelete"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr '저장'}" Margin="0,0,8,0" Click="OnEditorSave"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '저장 후 연결'}" Click="OnEditorSaveConnect"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24,0,24,20">
                                    <TextBlock Text="{l:Tr '프로토콜'}" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="3"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ProtoSsh" Style="{StaticResource Segment}" Content="SSH" GroupName="proto"
                                                         Checked="OnProtoChanged"/>
                                            <RadioButton x:Name="ProtoRdp" Style="{StaticResource Segment}" Content="RDP" GroupName="proto"
                                                         Checked="OnProtoChanged"/>
                                        </UniformGrid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="EdAddressLabel" Text="{l:Tr '주소'}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EdAddress" Tag="{l:Tr 'IP 또는 호스트명'}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{l:Tr '포트'}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EdPort"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{l:Tr '공인 IP (선택)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EdPublicIp" Tag="{l:Tr 'EIP 등 — 클라우드 호스트는 동기화 때 자동으로 채워짐'}"/>
                                    <CheckBox x:Name="EdUsePublic" Content="{l:Tr '공인 IP로 접속 (끄면 사설 IP / 위 주소)'}" Margin="0,10,0,0"/>

                                    <TextBlock Text="{l:Tr '이름'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EdLabel" Tag="{l:Tr '비워두면 주소가 표시됩니다'}"/>

                                    <TextBlock Text="{l:Tr '그룹'}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EdGroup" Tag="{l:Tr '예: Production, Staging, Web'}"/>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                FontSize="10" Width="38" Height="38" Padding="0" Margin="8,0,0,0" Click="OnPickGroup"
                                                ToolTip="{l:Tr '기존 그룹에서 고르기'}"/>
                                    </Grid>

                                    <!-- 로그인: Vault 계정(선택) + 직접 입력(비우면 Vault 값) -->
                                    <TextBlock Text="{l:Tr '로그인 계정'}" Style="{StaticResource FieldLabel}"/>
                                    <Border x:Name="VaultCard" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12,10"
                                            BorderBrush="{StaticResource Accent}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="EdVaultGlyph" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}"
                                                       FontSize="15" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="EdVaultName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="EdVaultDetail" FontSize="11.5" Foreground="{StaticResource SubText}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '변경'}" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                                        Click="OnPickVault"/>
                                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr '해제'}" Padding="10,4" FontSize="12"
                                                        Click="OnClearVault" ToolTip="{l:Tr 'Vault 계정을 쓰지 않고 아래에 직접 입력한 값만 사용'}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="VaultPickButton" Style="{StaticResource GhostButton}" Height="38" HorizontalAlignment="Stretch"
                                            Click="OnPickVault">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{l:Tr 'Vault 계정 선택  (선택 사항)'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="VaultHint" FontSize="11" Foreground="{StaticResource SubText}" Margin="2,6,0,0" TextWrapping="Wrap"/>

                                    <TextBlock x:Name="EdUserLabel" Text="{l:Tr '사용자명'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EdUser" Tag="{l:Tr '예: ubuntu  /  DOMAIN\\user'}"/>

                                    <TextBlock x:Name="EdPasswordLabel" Text="{l:Tr '비밀번호'}" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="EdPassword"/>
                                    <TextBlock x:Name="PwHint" FontSize="11" Foreground="{StaticResource SubText}" Margin="2,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel x:Name="KeyPanel">
                                        <TextBlock x:Name="EdKeyLabel" Text="{l:Tr '개인키 파일 (선택)'}" Style="{StaticResource FieldLabel}"/>
                                        <Grid x:Name="KeyFileRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="EdKey" Tag="{l:Tr 'OpenSSH / PuTTY(.ppk) 키 파일 경로'}"/>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{l:Tr '찾기'}" Margin="8,0,0,0"
                                                    Height="38" Click="OnBrowseKey"/>
                                        </Grid>
                                        <TextBlock x:Name="KeyHint" FontSize="11" Foreground="{StaticResource SubText}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 세션 뷰들 (탭 전환 시 Visibility 만 바꿔서 연결을 유지) -->
            <Grid x:Name="SessionsHost" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
