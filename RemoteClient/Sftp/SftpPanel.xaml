<UserControl x:Class="Nubis.SftpPanel"
             xmlns:l="clr-namespace:Nubis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Layer2Bg}" Foreground="{StaticResource TextPrimary}" FontSize="13">
    <UserControl.Resources>
        <!-- 툴바 묶음 사이 세로 구분선 -->
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource Stroke}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 열 머리글 버튼 (눌러서 정렬) — 평소 투명, hover 때 옅은 채움. 키보드(Tab · Space)로도 정렬할 수 있다 -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="l:Ui.CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="l:Ui.HoverBrush" Value="{StaticResource SubtleFillHover}"/>
        </Style>
        <!-- 머리글 정렬 화살표 글리프 -->
        <Style x:Key="SortArrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <!-- 전송 진행 막대: 3px 가는 막대. 전체 크기를 아직 모를 때(IsIndeterminate)는 흐린 막대 — 계속 도는 애니메이션은 쓰지 않는다 -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="{StaticResource StrokeSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 오른쪽 머리카락 선 = 터미널과의 경계 -->
    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 툴바: 제목 | 이동(상위 · 홈 · 터미널 폴더 · 새로고침) | 동작(새 폴더 · 업로드 · 다운로드) | 닫기 -->
        <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="SFTP" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Click="OnUp"
                            ToolTip="{l:Tr '상위 폴더 (Backspace)'}" AutomationProperties.Name="{l:Tr '상위 폴더 (Backspace)'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Click="OnHome"
                            ToolTip="{l:Tr '홈 폴더'}" AutomationProperties.Name="{l:Tr '홈 폴더'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE756;" Click="OnTerminalCwd"
                            ToolTip="{l:Tr '터미널의 현재 폴더로 이동'}" AutomationProperties.Name="{l:Tr '터미널의 현재 폴더로 이동'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRefresh"
                            ToolTip="{l:Tr '새로고침 (F5)'}" AutomationProperties.Name="{l:Tr '새로고침 (F5)'}"/>
                    <Border Style="{StaticResource ToolbarDivider}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" Click="OnNewFolder"
                            ToolTip="{l:Tr '새 폴더'}" AutomationProperties.Name="{l:Tr '새 폴더'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE898;" Click="OnUploadClick"
                            ToolTip="{l:Tr '업로드 (탐색기에서 끌어다 놓아도 됩니다)'}" AutomationProperties.Name="{l:Tr '업로드 (탐색기에서 끌어다 놓아도 됩니다)'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" Click="OnDownloadClick"
                            ToolTip="{l:Tr '선택 항목 다운로드 (탐색기로 끌어다 놓아도 됩니다)'}" AutomationProperties.Name="{l:Tr '선택 항목 다운로드 (탐색기로 끌어다 놓아도 됩니다)'}"/>
                    <Border Style="{StaticResource ToolbarDivider}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Click="OnClose"
                            ToolTip="{l:Tr '닫기'}" AutomationProperties.Name="{l:Tr '닫기'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 터미널을 따라 다른 사용자(root 등) 권한으로 열었을 때 — 경고색 옅은 띠 (UpdateRunAsBadge) -->
        <Border x:Name="RunAsBadge" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource WarningSubtle}"
                CornerRadius="{StaticResource RadiusMd}" Padding="10,5" Margin="8,8,8,0"
                ToolTip="{l:Tr '터미널을 따라 sudo 로 이 사용자 권한으로 열었습니다. 올린 파일의 소유자도 이 사용자가 됩니다.'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Warning}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="RunAsText" Grid.Column="1" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 경로 (~ · 상대 경로 입력 가능 — ResolvePathInput) -->
        <Grid Grid.Row="2" Margin="8,8,8,6">
            <TextBox x:Name="PathBox" Height="30" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="28,0,8,0"
                     Tag="{l:Tr '원격 경로'}" KeyDown="OnPathKeyDown" AutomationProperties.Name="{l:Tr '원격 경로'}"/>
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- 열 머리글 — 누르면 그 열로 정렬 (다시 누르면 반대로) — SftpPanel.List.cs.
             글자 위치를 행(바깥 6 + 안쪽 8 = 14)과 맞춘다: 머리글 Margin 8 + 버튼 Padding 6 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1" Padding="8,0,18,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="124"/>
                </Grid.ColumnDefinitions>
                <Button Tag="Name" Style="{StaticResource SortHeader}" HorizontalAlignment="Left" Click="OnSortHeader"
                        ToolTip="{l:Tr '눌러서 정렬'}" AutomationProperties.Name="{l:Tr '이름'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameHeader" Text="{l:Tr '이름'}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NameArrow" Style="{StaticResource SortArrow}" Margin="6,1,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="Size" Style="{StaticResource SortHeader}" HorizontalAlignment="Right" Click="OnSortHeader"
                        ToolTip="{l:Tr '눌러서 정렬'}" AutomationProperties.Name="{l:Tr '크기'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SizeArrow" Style="{StaticResource SortArrow}" Margin="0,1,6,0"/>
                        <TextBlock x:Name="SizeHeader" Text="{l:Tr '크기'}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="Modified" Style="{StaticResource SortHeader}" HorizontalAlignment="Right" Click="OnSortHeader"
                        ToolTip="{l:Tr '눌러서 정렬'}" AutomationProperties.Name="{l:Tr '수정한 날짜'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ModifiedArrow" Style="{StaticResource SortArrow}" Margin="0,1,6,0"/>
                        <TextBlock x:Name="ModifiedHeader" Text="{l:Tr '수정한 날짜'}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 파일 목록 (끌어다 놓아 업로드 · 탐색기로 끌어내 다운로드) -->
        <Grid Grid.Row="4">
            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" SelectionMode="Extended"
                     Padding="0,4,0,4"
                     AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
                     PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove" PreviewMouseLeftButtonUp="OnListMouseUp"
                     MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKeyDown"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr '편집 (저장하면 서버에 반영)'}" Click="OnOpenItem"/>
                        <MenuItem Header="{l:Tr '읽기 전용 사본 열기'}" Click="OnOpenCopy"/>
                        <MenuItem Header="{l:Tr '다운로드...'}" Click="OnDownloadClick"/>
                        <MenuItem Header="{l:Tr '이름 변경'}" Click="OnRename"/>
                        <MenuItem Header="{l:Tr '삭제'}" Click="OnDelete"/>
                        <MenuItem Header="{l:Tr '새 폴더'}" Click="OnNewFolder"/>
                        <MenuItem Header="{l:Tr '경로 복사'}" Click="OnCopyPath"/>
                        <Separator/>
                        <MenuItem x:Name="HiddenMenuItem" Header="{l:Tr '숨김 파일 표시'}" InputGestureText="Ctrl+H" IsChecked="True" Click="OnToggleHidden"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <!-- 행 컨테이너: Border 하나 (그림자 · 효과 · 애니메이션 없음 — 1만 행 이상에서도 가볍게). 높이 고정 28 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Height="28" Padding="8,0" Margin="6,0,6,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleFillHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtleHover}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <!-- 행 내용: Grid + TextBlock 4개, 모두 OneTime 바인딩. 숨김 파일 이름은 NameBrush 로 흐리게 (트리거 없이) -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding ToolTipText, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="124"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph, Mode=OneTime}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{Binding GlyphBrush, Mode=OneTime}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneTime}" Foreground="{Binding NameBrush, Mode=OneTime}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneTime}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedText, Mode=OneTime}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 끌어다 놓기 표시 -->
            <Border x:Name="DropHint" Margin="8" CornerRadius="{StaticResource RadiusLg}" BorderThickness="2" BorderBrush="{StaticResource Accent}"
                    Background="{StaticResource AccentSubtle}" IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource AccentText}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DropHintText" Foreground="{StaticResource AccentText}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 빈 폴더 · 숨김 파일만 · 오류 안내 (ShowMessage — 아이콘은 상황별) -->
            <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                <TextBlock x:Name="MessageIcon" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource TextTertiary}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="20"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 전송 상태: [상태 아이콘] 문구(파일 [n/N] · 양 · 속도 · 남은 시간) [취소] / 가는 진행 막대 -->
        <Border x:Name="TransferBar" Grid.Row="5" Background="{StaticResource Layer3Bg}" BorderBrush="{StaticResource StrokeSubtle}"
                BorderThickness="0,1,0,0" Padding="12,8,8,10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TransferIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TransferText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24"
                        Margin="6,0,0,0" l:Ui.HoverBrush="{StaticResource DangerSubtle}" Click="OnCancelTransfer"
                        ToolTip="{l:Tr '취소'}" AutomationProperties.Name="{l:Tr '취소'}"/>
                <ProgressBar x:Name="TransferProgress" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SlimProgress}"
                             Margin="0,8,4,0" Minimum="0" Maximum="1"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
